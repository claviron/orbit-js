{
  "name": "@claviron/orbit",
  "version": "0.1.2",
  "description": "Serve a Deno, Node or Bun application behind a Claviron edge over Orbit Link",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./binding": "./binding.js"
  },
  "files": [
    "index.js",
    "binding.js",
    "session.js",
    "framework.js",
    "native.js",
    "prebuilds/darwin-arm64/orbit.node",
    "prebuilds/freebsd-x64/orbit.node",
    "prebuilds/freebsd-arm64/orbit.node",
    "prebuilds/linux-x64-gnu/orbit.node",
    "prebuilds/linux-arm64-gnu/orbit.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bash scripts/build-native.sh",
    "test": "node --test tests/*.test.js",
    "check:package": "node scripts/check-package.js",
    "prepack": "node scripts/package.js",
    "prepublishOnly": "node scripts/package.js"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
