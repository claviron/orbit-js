{
  "name": "@claviron/orbit",
  "version": "0.1.0",
  "description": "Serve a Deno, Node or Bun application behind a Claviron edge over Orbit Link",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./binding": "./binding.js"
  },
  "files": ["index.js", "binding.js", "session.js", "framework.js", "native.js", "native/**/*.node", "README.md"],
  "scripts": {
    "build": "bash scripts/build-native.sh",
    "test": "node --test tests/*.test.js",
    "check:package": "node scripts/check-package.js",
    "prepack": "npm run check:package",
    "prepublishOnly": "npm run check:package"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
